FROM [search index=* sourcetype=WinEventLog:Microsoft-Windows-Sysmon/Operational EventCode=1 | eval process=lower(Image), cmd=lower(CommandLine)] WHERE (match(process, \\powershell\.exe) OR match(process, \\pwsh\.exe)) AND (like(cmd, %downloadstring%) OR like(cmd, %downloadfile%) OR like(cmd, %new-object net.webclient%) OR like(cmd, %invoke-webrequest%) OR like(cmd, %invoke-restmethod%) OR like(cmd, %start-bitstransfer%)) | table _time, host, User, ParentImage, Image, CommandLine, ProcessId, ParentProcessId
